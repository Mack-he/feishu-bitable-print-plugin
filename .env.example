# 数据库配置（二选一）
# 方式1（推荐）：键值对写法，密码可含 @ ! 等特殊字符
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=username
DATABASE_PASSWORD=password
DATABASE_NAME=print_plugin_db

# 方式2：连接串写法（密码不含特殊字符时可用）
# DATABASE_URL=mysql://username:password@localhost:3306/print_plugin_db

# 飞书应用配置
FEISHU_APP_ID=your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret
FEISHU_REDIRECT_URI=http://localhost:5000/api/auth/feishu/callback

# JWT 密钥（用于用户登录会话）
JWT_SECRET=your_jwt_secret_key_here

# 应用内置的部门定时同步（自建/Docker 部署用；Serverless 环境请改用外部调度器）
# 到点后按服务器本地时间执行，默认每天 03:00 与 15:00；停过的进程启动后会补跑一次
DEPARTMENT_SYNC_SCHEDULE_ENABLED=false
# 可选：自定义时间点，逗号分隔的 HH:mm
# DEPARTMENT_SYNC_SCHEDULE=03:00,15:00

# 外部调度器入口的密钥（可选：用内置调度就不需要配，接口会保持关闭并返回 503）
# 需要外部触发时再打开，生成示例：openssl rand -hex 24
# DEPARTMENT_SYNC_CRON_SECRET=your_department_sync_cron_secret

# 可选：定时同步的时间预算（毫秒），超时返回剩余进度供下次续传，默认 240000（4 分钟）
# DEPARTMENT_SYNC_TIME_BUDGET_MS=240000

# 可选：每次同步每批刷新多少用户，默认 500，上限 5000
# DEPARTMENT_SYNC_USER_BATCH=500

# 加密密钥（用于加密存储授权码，32字节，64个十六进制字符）
# 可以使用以下命令生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_char_hex_encryption_key_here

# Next.js 配置
NEXT_PUBLIC_APP_URL=http://localhost:5000
